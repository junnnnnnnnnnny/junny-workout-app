# --- Firebase (client, public) ---
# Firebase 콘솔 > 프로젝트 설정 > 일반 > 내 앱(웹) 에서 확인
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (server only, 절대 노출 금지) ---
# Firebase 콘솔 > 프로젝트 설정 > 서비스 계정 > 새 비공개 키 생성
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# private key는 개행을 \n 문자로 escape해서 한 줄로 넣기
FIREBASE_PRIVATE_KEY=

# --- Anthropic (server only, 절대 노출 금지) ---
ANTHROPIC_API_KEY=

# --- 관리자 계정 (client, public) ---
# 공통 운동 DB에 새 운동을 등록할 수 있는 계정의 Firebase UID.
# Firebase 콘솔 > Authentication 에서 확인. firestore.rules의 exercises 규칙과 값을 맞춰야 함.
NEXT_PUBLIC_ADMIN_UID=
