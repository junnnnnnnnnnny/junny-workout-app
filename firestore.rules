rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 모든 데이터는 users/{uid} 아래에 있으며, 본인만 읽고 쓸 수 있다.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /{subcollection}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
